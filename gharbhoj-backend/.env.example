PORT=4000
# Same address you type into MongoDB Compass. "gharbhoj" is the database name (created automatically).
MONGO_URI=mongodb://127.0.0.1:27017/gharbhoj
# Any long random text. It signs the admin login tokens, so keep it secret.
JWT_SECRET=change-this-to-a-long-random-text
# The address of your React app (needed so the browser allows the requests).
CLIENT_URL=http://localhost:5173
# The admin account that `npm run seed` creates.
ADMIN_EMAIL=admin@gharbhoj.in
ADMIN_PASSWORD=admin123
